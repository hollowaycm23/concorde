{
  "name": "concorde",
  "version": "3.0.0",
  "description": "Concorde - Chat desktop com voz, video e E2E",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "publish:win": "electron-builder --win --x64 --publish always",
    "release": "node scripts/publish-release.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.3.1",
    "electron-log": "^5.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "express": "^4.18.2",
    "livekit-server-sdk": "^1.2.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0",
    "web-push": "^3.6.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@octokit/rest": "^20.0.2",
    "electron": "^37.2.0",
    "electron-builder": "^24.13.3",
    "socket.io-client": "^4.8.3"
  },
  "build": {
    "appId": "com.concorde.app",
    "productName": "Concorde",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "extraFiles": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "hollowaycm23",
      "repo": "concorde",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/concorde.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Concorde"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@37.10.3": true
  }
}
